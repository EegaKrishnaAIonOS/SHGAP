~$*

# T14/T15 feature pipeline + model registry output (regenerated by running
# the pipeline/training scripts, not source) — everything under ml-services'
# data dir is generated except the placeholder that keeps it in git.
*.parquet
apps/ml-services/data/**
!apps/ml-services/data/.gitkeep

# T23 Playwright E2E output (regenerated by every `npm run test:e2e`).
apps/web/e2e-report/
apps/web/test-results/
apps/web/playwright-report/

# T23 k6 load-test tokens (real, short-lived JWTs minted by get-tokens.sh —
# never commit a live access token even a dev-only one).
apps/core-api/test/load/tokens.json

# T24 real Postgres backups (infra/scripts/backup-postgres.sh output) —
# contains real data, never committed.
infra/backups/

# T24 Terraform working files — the downloaded provider plugins directory
# and any real state. `.terraform.lock.hcl` is deliberately NOT listed here
# (Terraform's own convention is to commit it, like package-lock.json, for
# reproducible provider versions) — real state belongs in a remote backend
# (S3 + DynamoDB lock table, per docs/deployment-guide.md), never a local
# .tfstate file, committed or not.
infra/terraform/.terraform/
infra/terraform/**/.terraform/
*.tfstate
*.tfstate.*
